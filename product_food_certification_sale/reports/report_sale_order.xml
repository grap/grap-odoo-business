<odoo>

    <template id="report_sale_order" inherit_id="sale.report_saleorder_document">
        <xpath expr="//th[@name='th_quantity']" position="before">
            <th t-if="doc.display_organic_column" class="text-center"><span >ORG</span></th>
        </xpath>

        <xpath expr="//td[@name='td_quantity']" position="before">
            <td t-if="doc.display_organic_column" class="text-center">
                <span t-if="line.product_id.organic_type == '01_organic'">ORG</span>
            </td>
        </xpath>

        <xpath expr="//div[@id='total']/.." position="before">
            <div t-if="doc.display_organic_column" t-field="doc.company_id.report_certifier_text"/>
        </xpath>

    </template>

</odoo>
