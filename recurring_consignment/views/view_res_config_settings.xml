<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
                name="inherit_id"
                ref="account.res_config_settings_view_form"
            />
        <field name="arch" type="xml">

            <div data-key="account" position="inside">
                <h2 groups="recurring_consignment.group_consignment_manager">Recurring Consignment</h2>
                <div class="row mt16 o_settings_container" id="recurring_consignment"
                    groups="recurring_consignment.group_consignment_manager">

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane mt16">
                            <label for="commission_product_id"/>
                            <span class="fa fa-lg fa-building-o" role="img" title="Values set here are company-specific." groups="base.group_multi_company"/>
                            <div>
                                <field name="commission_product_id"/>
                            </div>
                            <div class="text-muted">Product that will be used to generate consignment invoices to consignors.</div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane mt16">
                            <label for="commission_deduction_journal_id"/>
                            <span class="fa fa-lg fa-building-o" role="img" title="Values set here are company-specific." groups="base.group_multi_company"/>
                            <div>
                                <field name="commission_deduction_journal_id"/>
                            </div>
                            <div class="text-muted">Miscellaneous Journal, used to generate an entry that deducts the commission from the amount to be paid out.</div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane mt16">
                            <label for="recurring_consignment_account_prefix"/>
                            <span class="fa fa-lg fa-building-o" role="img" title="Values set here are company-specific." groups="base.group_multi_company"/>
                            <div>
                                <field name="recurring_consignment_account_prefix"/>
                            </div>
                            <div class="text-muted">Code used as prefix to generate account code of the consignors.</div>
                        </div>
                    </div>

                </div>

            </div>

        </field>
    </record>

</odoo>
