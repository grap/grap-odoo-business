<odoo>

    <!-- ************************************************************ -->
    <!-- ************************************************************ -->
    <!-- Product.template Search View -->

    <record id="view_mrp_product_price_quick_menus_product_search" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="mrp.mrp_product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='manufactured_products']" position="attributes">
              <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='filter_is_intermediate']" position="before">
                <filter string="Finished products" name="filter_is_finished" domain="[('bom_ids', '!=', False), ('bom_line_ids', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <!-- ************************************************************ -->
    <!-- Menu "Handle prices" - Step 1 : Composants Products -->
    <!-- ************************************************************ -->

    <record id="view_mrp_product_price_quick_menus_product" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="false" decoration-danger="standard_price == 0">
                <field name="default_code" string="Ref."/>
                <field name="name"/>
                <field name="categ_id" string="Categ."/>
                <field name="currency_id" invisible="1"/>
                <field name="standard_price" string="Price" widget="monetary" options="{'display_currency': 'currency_id', 'field_digits': True}"/>
                <field name="uom_id" string="UoM" readonly="1"/>
                <field name="standard_price_change_date" string="Date&#160;Last&#160;Statement&#160;Price"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="action_product_product_mrp_tree" model="ir.actions.act_window">
        <field name="name">Components Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_mrp_product_price_quick_menus_product"/>
        <field name="context">{"search_default_filter_is_component":1}</field>
    </record>

    <!-- ************************************************************ -->
    <!-- Menu "Handle prices" - Step 3 : Finished Products -->
    <!-- ************************************************************ -->

    <!-- MRP Handling Prices Menu Step 3 : Products Update Margin and Sale Price -->
    <record id="view_handle_sale_price_tree" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-warning="margin_state == 'too_expensive'" decoration-danger="margin_state == 'too_cheap'" create="false">
              <field name="default_code" readonly="1" string="Ref."/>
              <field name="name" string="Product" readonly="1"/>
              <field name="standard_price" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
              <field name="currency_id" invisible="1"/>
              <field name="list_price" string="List&#160;Price" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
              <field name="margin_classification_id"/>
              <field name="standard_margin_rate" string="Theorical Margin (%)"/>
              <field name="theoretical_price" string="Theorical&#160;Price" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}" attrs="{'invisible': [('theoretical_difference', '=', 0)]}"/>
              <field name="margin_state"/>
              <button name="use_theoretical_price" type="object" string="Apply Margin" icon="fa-arrow-up" attrs="{'invisible': [('margin_state', '!=', 'too_cheap')]}" help="Increase the Sale Price up to Theoretical Price"/>
              <button name="use_theoretical_price" type="object" string="Apply Margin" icon="fa-arrow-down" attrs="{'invisible': [('margin_state', '!=', 'too_expensive')]}" help="Decrease the Sale Price down to Theoretical Price"/>
              <field name="theoretical_difference" string="Theorical&#160;difference" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
              <field name="company_id" groups="base.group_multi_company" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="action_product_product_tree_finished_products" model="ir.actions.act_window">
        <field name="name">Products - Update Margin and Sale Price</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_handle_sale_price_tree"/>
        <field name="context">{"search_default_filter_is_finished":1, "search_default_filter_to_sell":1}</field>
    </record>


</odoo>
