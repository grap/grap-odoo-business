<odoo>

    <!-- ************************************************************ -->
    <!-- Menus and actions for "Handling Prices" -->
    <!-- ************************************************************ -->
    <menuitem id="mrp_product_price_quick_menus"
      name="Handle prices"
      parent="mrp.menu_mrp_root" sequence="20"/>

    <!-- Step 1 : Composants Products -->
    <menuitem id="mrp_product_price_quick_menus_market_pricelist"
      name="1. Set Products standard prices"
      parent="mrp_product_price_quick_menus"
      action="mrp_product_price_quick_menus.action_product_product_mrp_tree"
      sequence="10"/>

    <!-- Step 2 : BoMs -->
    <menuitem id="mrp_product_price_quick_menus_standard_prices_2_intermediate"
      name="2. Update intermediate BoMs costs"
      parent="mrp_product_price_quick_menus"
      action="action_mrp_bom_intermediate_products_price"
      sequence="20"/>

    <menuitem id="mrp_product_price_quick_menus_standard_prices_3_finished"
        name="3. Update the cost of finished product BoM"
        parent="mrp_product_price_quick_menus"
        action="action_mrp_bom_finished_products_price"
        sequence="30"/>

    <!-- Step 3 : Products -->
    <menuitem id="menu_product_product_mrp_handle_prices_standard_prices_4_finished"
      name="4. Manage sale price and margin of finished products"
      parent="mrp_product_price_quick_menus"
      action="action_product_product_tree_finished_products"
      sequence="40"/>

  </odoo>
