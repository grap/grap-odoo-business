<odoo>

    <!-- ************************************************************ -->
    <!-- Menus and actions for "Handling Prices" -->
    <!-- ************************************************************ -->
    <menuitem id="mrp_product_price_quick_menus"
      name="Handle prices"
      parent="mrp.menu_mrp_root" sequence="20"/>

    <!-- Step 1 : Composants Products -->
    <menuitem id="mrp_product_price_quick_menus_market_pricelist"
      name="1. Set Products standard prices"
      parent="mrp_product_price_quick_menus" sequence="10"/>

    <menuitem id="mrp_product_price_quick_menus_1a_composants"
        name="Composants products"
        parent="mrp_product_price_quick_menus_market_pricelist" sequence="1"
        action="mrp_product_price_quick_menus.action_product_product_mrp_tree"/>

    <!-- Step 2 : BoMs -->
    <menuitem id="mrp_product_price_quick_menus_bom_prices"
      name="2. Update BoMs costs"
      parent="mrp_product_price_quick_menus" sequence="20"/>

    <menuitem id="mrp_product_price_quick_menus_standard_prices_2a_intermediate"
        name="BoM for intermediates products"
        parent="mrp_product_price_quick_menus_bom_prices" sequence="1"
        action="action_mrp_bom_intermediate_products_price"/>

    <menuitem id="mrp_product_price_quick_menus_standard_prices_2b_finished"
        name="BoM for finished products"
        parent="mrp_product_price_quick_menus_bom_prices" sequence="2"
        action="action_mrp_bom_finished_products_price"/>

    <!-- Step 3 : Products -->
    <menuitem id="menu_product_product_mrp_handle_prices"
      name="3. Handle Products sale prices"
      parent="mrp_product_price_quick_menus" sequence="30"/>

    <menuitem id="menu_product_product_mrp_handle_prices_standard_prices_3a_finished"
        name="Finished products"
        parent="menu_product_product_mrp_handle_prices" sequence="1"
        action="action_product_product_tree_finished_products"/>

  </odoo>
