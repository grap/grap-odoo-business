<odoo>

    <record id="view_sale_recovery_moment_search" model="ir.ui.view">
        <field name="model">sale.recovery.moment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="futur" string="Futur" domain="[('state','=','futur')]"/>
                <filter name="pending" string="Pending" domain="[('state','in',('pending_sale', 'finished_sale', 'pending_recovery'))]"/>
                <filter name="not_finished" string="Not Finished"
                    domain="[('state','in', ('futur', 'pending_sale', 'finished_sale', 'pending_recovery'))]"/>
                <filter name="finished" string="Finished" domain="[('state','=','finished_recovery')]"/>
            </search>
        </field>
    </record>

    <record id="view_sale_recovery_moment_tree" model="ir.ui.view">
        <field name="model">sale.recovery.moment</field>
        <field name="arch" type="xml">
             <header>
                    <button name="action_sale_recovery_moment_wizard_duplicate" type="object" string="Duplicate moments"/>
            </header>

            <tree
                    decoration-muted="state=='finished_recovery'"
                    decoration-info="state == 'futur'"
                    decoration-success="state in ('finished_sale', 'pending_recovery')">
                <field name="place_id"/>
                <field name="max_order_qty" string="Max"/>
                <field name="min_recovery_date"/>
                <field name="max_recovery_date"/>
                <field name="description"/>
                <field name="state"/>
                <field name="order_qty" string="S.O. Qty"/>
                <button name="%(action_recovery_moment_2_sale_order_valid)d" icon="fa-shopping-basket" string="See" type="action" />
                <field name="picking_qty" string="D.O. Qty" />
                <button name="%(action_recovery_moment_2_stock_picking)d" icon="fa-truck" string="See" type="action" />
            </tree>
        </field>
    </record>

    <record id="view_sale_recovery_moment_calendar" model="ir.ui.view">
        <field name="model">sale.recovery.moment</field>
        <field name="arch" type="xml">
            <calendar date_start="min_recovery_date" date_stop="max_recovery_date"
                event_open_popup="True" quick_add="False"
                color="place_id" mode="week">
                <field name="place_id" filters="1"/>
                <field name="quota_description"/>
            </calendar>
        </field>
    </record>

    <record id="view_sale_recovery_moment_form" model="ir.ui.view">
        <field name="model">sale.recovery.moment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>

                </header>
                <sheet>
                    <!-- Button box -->
                    <div class="oe_button_box" name="button_box">
                        <!-- Sale Orders -->
                        <button
                            class="oe_stat_button"
                            type="action"
                            icon="fa-shopping-basket"
                            name="%(action_recovery_moment_2_sale_order_valid)d"
                        >
                            <div class="o_field_widget o_stat_info">
                              <span class="o_stat_value"><field
                                        name="order_qty"
                                        widget="statinfo"
                                        nolabel="1"
                                    /></span>
                              <span class="o_stat_text">Customers Orders</span>
                            </div>
                        </button>

                        <!-- Pickings -->
                        <button
                            class="oe_stat_button"
                            type="action"
                            icon="fa-truck"
                            name="%(action_recovery_moment_2_stock_picking)d"
                        >
                            <div class="o_field_widget o_stat_info">
                              <span class="o_stat_value"><field
                                        name="picking_qty"
                                        widget="statinfo"
                                        nolabel="1"
                                    /></span>
                              <span class="o_stat_text">Delivery Orders</span>
                            </div>
                        </button>

                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="place_id"/>
                            <field name="max_order_qty" widget="numeric_step" options="{'step': 1, 'min': 0}"/>
                            <field name="description" placeholder="e.g : Exceptional recovery moment : taste and buy amazing beers !"/>
                            <field name="group_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <div class="my-4">
                        <h4>
                            <i class="fa fa-map-pin" aria-hidden="true"></i>
                            Recovery moment
                        </h4>
                            <span class="me-2">Customer could get their order between</span>
                            <field name="min_recovery_date" nolabel="1" class="me-2"/>
                            <span class="me-2">and</span>
                            <field name="max_recovery_date" nolabel="1"/>
                    </div>

                    <div class="my-4">
                        <h4>
                            <i class="fa fa-shopping-basket" aria-hidden="true"></i>
                            Customer Orders
                        </h4>
                        <span class="me-2">Customer could order between</span>
                        <field name="min_sale_date" nolabel="1" class="me-2" attrs="{'readonly': [('group_id', '!=', False)]}"/>
                        <span class="me-2">and</span>
                        <field name="max_sale_date" nolabel="1" attrs="{'readonly': [('group_id', '!=', False)]}"/>
                        <div class="alert alert-info w-50" role="alert" attrs="{'invisible': [('group_id', '==', False)]}">
                          Modify this dates in recovery moment group : <field name="group_id" />

                        </div>
                    </div>


                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_recovery_moment" model="ir.actions.act_window">
        <field name="name">Recovery Moments</field>
        <field name="res_model">sale.recovery.moment</field>
        <field name="view_mode">calendar,tree,form</field>
        <field name="context">{'search_default_not_finished':1}</field>
    </record>

    <menuitem id="menu_sale_recovery_moment"
        sequence="200"
        parent="sale.sale_order_menu"
        action="action_sale_recovery_moment"/>

</odoo>
