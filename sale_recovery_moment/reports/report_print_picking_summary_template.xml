<odoo>

    <template id="picking_summary" inherit_id="stock_picking_report_summary.picking_summary">
        <xpath expr="//span[@t-field='picking_line.picking_id.name']" position="after">
            <t t-if="picking_line.picking_id.recovery_moment_id">
                <br />
                Recovery: <span t-field="picking_line.picking_id.recovery_moment_id.place_id.name"/> (<span t-field="picking_line.picking_id.recovery_moment_id.min_sale_date"/>)
            </t>
        </xpath>
    </template>

</odoo>
