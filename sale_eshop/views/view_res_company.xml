<odoo>

    <record id="view_res_company_form" model="ir.ui.view">
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="eShop" colspan="4">
                    <group>
                        <group string="Basic Settings">
                            <field name="has_eshop"/>
                            <field name="eshop_image_128" widget="image" class="oe_avatar" attrs="{'invisible' : [('has_eshop', '=', False)]}"/>
                            <field name="eshop_title" attrs="{'invisible' : [('has_eshop', '=', False)]}"/>
                            <field name="eshop_minimum_price" attrs="{'invisible' : [('has_eshop', '=', False)]}"/>
                            <field name="eshop_pricelist_id" attrs="{'invisible' : [('has_eshop', '=', False)]}"/>
                            <field name="eshop_manage_recovery_moment" attrs="{'invisible' : [('has_eshop', '=', False)]}"/>
                            <field name="eshop_vat_included" attrs="{'invisible' : [('has_eshop', '=', False)]}"/>
                        </group>
                        <group string="Legal Notices" attrs="{'invisible' : [('has_eshop', '=', False)]}">
                            <field name="eshop_hosting"/>
                            <field name="eshop_registered_capital"/>
                            <field name="eshop_consumer_mediation"/>
                        </group>
                        <group string="Register Options" attrs="{'invisible' : [('has_eshop', '=', False)]}">
                            <field name="eshop_register_allowed"/>
                            <field name="eshop_register_phone_required"/>
                        </group>
                        <group string="Screen Options" attrs="{'invisible' : [('has_eshop', '=', False)]}">
                            <field name="eshop_list_view_enabled"/>
                            <field name="eshop_catalog_view_enabled"/>
                        </group>
                        <group string="Payment Options" attrs="{'invisible' : [('has_eshop', '=', False)]}">
                            <field name="eshop_pay_on_site" string="Option : Payment on site" />
                            <field name="eshop_pay_on_site_text"
                                   attrs="{'required' : [('has_eshop', '=', True), ('eshop_pay_on_site', '=', True)], 'invisible' : [('eshop_pay_on_site', '=', False)]}"
                                   string="Custom text for payment methods on site"
                                   placeholder="E.g : On site, we accept cash and checks but not credit card."/>
                            <br/><br/>
                            <field name="eshop_wallet_enabled" string="Option : Payment with wallet"/>
                            <field name="eshop_wallet_recharge_bank"/>
                            <br/><br/>
                            <field name="eshop_mollie_enabled" string="Option : Payment online with Mollie"/>
                        </group>
                        <group string="Technical Settings" attrs="{'invisible' : [('has_eshop', '=', False)]}">
                            <field name="eshop_url"/>
                            <field name="eshop_invalidation_key"/>
                        </group>
                    </group>
                    <group string="Welcome page" attrs="{'invisible' : [('has_eshop', '=', False)]}">
                        <field name="eshop_home_text"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
