<odoo>

    <!-- FORM -->
    <record id="view_sale_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="note" position="before">
                <field name="eshop_note" groups="sale_eshop.res_groups_eshop_user"/>
            </field>
            <field name="source_id" position="after">
                <field name="eshop_sale" groups="sale_eshop.res_groups_eshop_user" readonly='True'/>
            </field>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_eshop_sale_order_search" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="before">
                <filter string="Eshop Sale" name="filter_eshop_sale"
                    groups="sale_eshop.res_groups_eshop_user"
                    domain="[('eshop_sale', '=', True)]"/>
                <separator/>
                <filter string="Delivery date not passed" name="filter_sale_delivery_date_not_passed"
                    domain="['|', ('commitment_date', '=', False), ('commitment_date', '&gt;',  context_today())]"/>
                <separator/>
            </filter>
        </field>
    </record>

</odoo>
