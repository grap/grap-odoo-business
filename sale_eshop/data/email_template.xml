<odoo>
    <data>
        <record id="eshop_send_credential_template" model="mail.template">
            <field name="name">eShop Access Email</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">[{{ user.company_id.name }}] Your eShop Access</field>
            <field name="partner_to">{{ object.id }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello <t t-out="object.name"></t>,</p>

                    <t t-if="object.eshop_state == 'email_to_confirm'">
                        <p>Before you can connect, please complete your registration by clicking on the following link: 
                            <a t-att-href="(user.company_id.eshop_url) + 'activate_account/' + str(object.id) + '/' + (object.email)">
                                Activate my account
                            </a>
                        </p>
                    </t>

                    <p>Here is your credentials to access to our purchase website:</p>

                    <ul>
                        <li>
                            <strong>Website:</strong>
                            <a t-att-href="user.company_id.eshop_url">
                                <t t-out="user.company_id.eshop_url or ''"/>
                            </a> 
                        </li>
                        <li><strong>Login:</strong> <t t-out="object.email"/></li>
                        <li><strong>Password:</strong> The one you set during your registration</li>
                    </ul>

                    <p>Have a nice day<br/>
                    <t t-out="object.company_id.name"/></p>
                </div>

            </field>
        </record>
    </data>
</odoo>

