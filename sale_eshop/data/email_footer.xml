<odoo>
    <data>

        <template id="email_footer">

            <tr>
                <td align="center" style="min-width: 590px;">
                    <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;">
                        <tr><td valign="middle" align="left">
                            <t t-out="user.company_id.name or ''"></t>
                        </td></tr>
                        <tr><td valign="middle" align="left" style="opacity: 0.7;">
                            <t t-out="user.company_id.phone or ''"></t>
                            <t t-if="user.company_id.email">
                                | <a t-attf-href="'mailto:' + (user.company_id.email)" style="text-decoration:none; color: #454748;">
                                    <t t-out="user.company_id.email or ''"/>
                                  </a>
                            </t>
                            <t t-if="user.company_id.website">
                                | <a t-attf-href="'user.company_id.website" style="text-decoration:none; color: #454748;"><t t-out="user.company_id.website or ''"/></a>
                            </t>
                        </td></tr>
                    </table>
                </td>
            </tr>

        </template>
    </data>

</odoo>
