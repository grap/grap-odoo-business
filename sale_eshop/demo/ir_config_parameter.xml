<odoo>

    <function
        model="ir.config_parameter"
        name="set_param"
        eval="[
            obj().env.ref('base.main_company')._get_eshop_config_name('eshop_url'),
            'http://127.0.0.1:8080/'
        ]"
    />

    <function
        model="ir.config_parameter"
        name="set_param"
        eval="[
            obj().env.ref('base.main_company')._get_eshop_config_name('eshop_invalidation_key'),
            'INVALIDATION_KEY'
        ]"
    />

</odoo>
