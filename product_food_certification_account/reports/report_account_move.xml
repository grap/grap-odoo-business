<odoo>

    <template id="report_account_move" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_quantity']" position="before">
            <th t-if="o.display_organic_column" class="text-center" name="th_organic"><span >ORG</span></th>
        </xpath>

        <xpath expr="//span[@t-field='line.quantity']/.." position="before">
            <td t-if="o.display_organic_column" class="text-center">
                <span t-if="line.product_id.organic_type == '01_organic'">ORG</span>
            </td>
        </xpath>

        <xpath expr="//div[@id='total']/.." position="before">
            <div t-if="o.display_organic_column" t-field="o.company_id.report_certifier_text"/>
        </xpath>

    </template>

</odoo>
