<odoo>

    <record id="view_product_template_only_form" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_print_category.view_product_template_only_form" />
        <field name="arch" type="xml">
            <field name="print_category_id" position="after">
                <field name="pricetag_type_id" attrs="{'invisible': [('product_variant_count', '&gt;', 1)]}"/>
                <field name="pricetag_uom_id" attrs="{'invisible': [('product_variant_count', '&gt;', 1)]}"/>
            </field>
        </field>
    </record>

</odoo>
